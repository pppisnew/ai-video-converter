<Page
    x:Class="VideoConverter.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:VideoConverter.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 窗口宽度自适应：窄窗（<1120 DIP）参数卡落到第二行，宽窗两列并排。
             宽窗布局即 FileLayout 上的本地值，只有窄窗需要 Setter 覆盖。 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LayoutStates">
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SettingsColumn.Width" Value="0" />
                        <Setter Target="SettingsCard.(Grid.Column)" Value="0" />
                        <Setter Target="SettingsCard.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1120" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 空态：拖放面板撑满内容区，不再是一段悬在窄列里的居中文字 -->
        <Grid Grid.Row="0" Padding="24,20"
              Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverse}}">
            <Border Background="{ThemeResource AppCardBackground}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <FontIcon Glyph="&#xE8B7;" FontSize="56" Opacity="0.3" HorizontalAlignment="Center" />
                    <TextBlock Text="把视频拖到这里" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center"
                               TextAlignment="Center" MaxWidth="420"
                               Text="支持 mp4 / mov / mkv / avi / webm / flv / wmv / ts 等常见格式，可一次选择多个文件。" />
                    <Button HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Padding="16,8"
                            Click="PickFileButton_Click"
                            AutomationProperties.Name="选择视频文件" AutomationProperties.AutomationId="PickFileButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                            <TextBlock Text="选择视频文件" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 有文件态：统一内容容器（内边距 24/20，宽度等于视口宽度，不设上限以免宽窗溢出） -->
        <ScrollViewer Grid.Row="0" Style="{StaticResource PageScrollViewerStyle}"
                      Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
            <Grid x:Name="FileLayout" Padding="24,20" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsColumn" Width="400" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 当前文件：选中文件后才存在 -->
                <Border VerticalAlignment="Top" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                Click="PickFileButton_Click"
                                AutomationProperties.Name="添加文件" AutomationProperties.AutomationId="AddFilesButton">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                                    <TextBlock Text="添加文件" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="220" Height="124" CornerRadius="4" VerticalAlignment="Top"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock FontSize="12" Opacity="0.7">
                                    <Run Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="11"
                                           Opacity="0.5" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" />
                                <Grid ColumnSpacing="6" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="缩略图时间点" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <ctl:NoWheelNumberBox Grid.Column="1" Value="{x:Bind ViewModel.ThumbnailPosition, Mode=TwoWay}"
                                        Minimum="0" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                        AutomationProperties.Name="缩略图时间点" />
                                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="7,3" FontSize="11"
                                            Command="{x:Bind ViewModel.CaptureThumbnailCommand, Mode=OneWay}"
                                            ToolTipService.ToolTip="按当前时间点重新截取缩略图"
                                            AutomationProperties.Name="重新截取缩略图" AutomationProperties.AutomationId="RecaptureButton">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="重新截取" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 详细信息：键值两列铺满卡片宽度，值左对齐 -->
                                <Expander Margin="-12,4,-12,0" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="详细信息">
                                    <Expander.Header>
                                        <TextBlock Text="详细信息" FontSize="12" />
                                    </Expander.Header>
                                    <Grid ColumnSpacing="24" RowSpacing="5" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="大小" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="容器格式" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.ContainerText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="时长" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="分辨率" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="帧率" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="视频编码" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind ViewModel.VideoCodecText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="音频编码" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.AudioCodecText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="声道数" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{x:Bind ViewModel.AudioChannelsText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="总码率" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.BitRateText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="输出路径" Style="{StaticResource SubtleTextStyle}" />
                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 转换设置：宽窗固定 400 DIP 右列，窄窗整行落到第二行 -->
                <Border x:Name="SettingsCard" Grid.Row="0" Grid.Column="1" VerticalAlignment="Top"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="转换设置" Style="{StaticResource SectionHeaderStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="88" />
                                <ColumnDefinition Width="*" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="容器格式" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                            <ctl:NoWheelComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                AutomationProperties.Name="容器格式" />
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="88" />
                                <ColumnDefinition Width="*" MaxWidth="420" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="视频编码器" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                            <ctl:NoWheelComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedEncoderOption, Mode=TwoWay}"
                                AutomationProperties.Name="视频编码器">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EncoderOption" xmlns:vm="using:VideoConverter.ViewModels">
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ctl:NoWheelComboBox>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="88" />
                                <ColumnDefinition Width="*" MaxWidth="420" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="质量" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                            <ctl:NoWheelSlider Grid.Column="1" Minimum="0" Maximum="51"
                                Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" VerticalAlignment="Center"
                                AutomationProperties.Name="质量" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Crf, Mode=OneWay}" FontSize="12"
                                       VerticalAlignment="Center" MinWidth="24" />
                        </Grid>
                        <TextBlock Text="数值越小质量越高（0-51）" FontSize="11" Opacity="0.5" Margin="100,0,0,0" />

                        <Expander Margin="-16,0,-16,0" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="高级选项">
                            <Expander.Header>
                                <TextBlock Text="高级选项" FontSize="12" />
                            </Expander.Header>
                            <StackPanel Spacing="10" Margin="0,4,0,0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="88" />
                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="分辨率" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                                    <ctl:NoWheelComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                        ItemsSource="{x:Bind ViewModel.ScaleOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedScaleOption, Mode=TwoWay}"
                                        AutomationProperties.Name="分辨率">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScaleOption" xmlns:vm="using:VideoConverter.ViewModels">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ctl:NoWheelComboBox>
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" MinWidth="88" />
                                        <ColumnDefinition Width="*" MaxWidth="420" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="音频码率" VerticalAlignment="Center" Style="{StaticResource SubtleTextStyle}" />
                                    <ctl:NoWheelNumberBox Grid.Column="1" HorizontalAlignment="Stretch"
                                        Value="{x:Bind ViewModel.AudioBitrate, Mode=TwoWay}"
                                        Minimum="32" Maximum="512" SmallChange="16" LargeChange="64"
                                        SpinButtonPlacementMode="Compact" AutomationProperties.Name="音频码率" />
                                </Grid>
                                <TextBlock Text="输出目录在设置页配置；参数在任务开始时捕获，会应用到全部勾选的待转换任务。"
                                           FontSize="11" Opacity="0.5" Margin="100,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,8" CornerRadius="4">
                            <TextBlock Text="{x:Bind ViewModel.ParameterSummary, Mode=OneWay}" FontSize="12"
                                       Foreground="{x:Bind ViewModel.ParameterSummaryBrush, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Command="{x:Bind ViewModel.ResetParametersCommand, Mode=OneWay}"
                                AutomationProperties.Name="重置为默认">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="重置为默认" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 固定操作条：位于 ScrollViewer 之外，窗口再矮"开始转换"也不会滚走 -->
        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="24,10">
                <StackPanel Spacing="8">
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6"
                                 Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.BatchHintText, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}" Style="{StaticResource SubtleTextStyle}"
                                       Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Padding="12,8" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.CancelCurrentCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                ToolTipService.ToolTip="取消当前任务，队列继续" AutomationProperties.Name="取消当前">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="13" />
                                <TextBlock Text="取消当前" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Padding="12,8" Style="{StaticResource SubtleButtonStyle}"
                                Command="{x:Bind ViewModel.CancelAllCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                ToolTipService.ToolTip="停止整个队列" AutomationProperties.Name="全部停止">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73B;" FontSize="13" />
                                <TextBlock Text="全部停止" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3" Padding="16,8" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanStartConvert, Mode=OneWay}"
                                AutomationProperties.Name="开始转换" AutomationProperties.AutomationId="ConvertButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15" />
                                <TextBlock Text="开始转换" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
