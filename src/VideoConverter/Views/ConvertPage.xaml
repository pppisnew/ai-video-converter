<Page
    x:Class="VideoConverter.Views.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="using:VideoConverter.Controls"
    xmlns:models="using:VideoConverter.Core.Models">

    <!-- 转换工作台：左列（拖放区 + 转换队列 + 媒体信息）/ 右列（输出设置面板，372 DIP） -->
    <Grid>
        <ScrollViewer Style="{StaticResource PageScrollViewerStyle}">
            <Grid Padding="24,20">
                <Grid x:Name="ConvertLayout" ColumnSpacing="20" RowSpacing="20">
                    <!-- 宽度断点（<1100 DIP 单列）在代码后置里按 XamlRoot 宽度切换，见 ConvertPage.xaml.cs -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="SettingsColumn" Width="372" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 页头：横跨两列（原型中正文标题在网格之上） -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                        <TextBlock Text="视频转换" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Style="{StaticResource PageSubtitleStyle}"
                                   Text="添加视频，选择输出设置，一键转换。支持 MP4、MKV、AVI、MOV、WebM 及音频提取。" />
                    </StackPanel>

                    <!-- 左列 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="20">

                        <!-- 拖放区：整块可点（复用选择器），拖入窗口时由窗口事件高亮 -->
                        <Grid MinHeight="150">
                            <Rectangle x:Name="DropzoneStroke" RadiusX="8" RadiusY="8" StrokeThickness="1.5"
                                       StrokeDashArray="4 3"
                                       Stroke="{ThemeResource AppDropzoneStroke}"
                                       Fill="{ThemeResource AppDropzoneFill}" />
                            <Button x:Name="DropzoneButton" Background="Transparent" BorderThickness="0"
                                    CornerRadius="8" Padding="0"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Click="PickFileButton_Click"
                                    PointerEntered="DropzoneButton_PointerEntered"
                                    PointerExited="DropzoneButton_PointerExited"
                                    AutomationProperties.Name="选择视频文件" AutomationProperties.AutomationId="PickFileButton">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon Glyph="&#xE714;" FontSize="44"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              HorizontalAlignment="Center" />
                                    <TextBlock Text="将视频文件拖到这里" FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock FontSize="13" Foreground="{ThemeResource AppSubtleText}"
                                               HorizontalAlignment="Center" TextAlignment="Center">
                                        <Run Text="或 " />
                                        <Run Text="点击选择文件" FontWeight="SemiBold"
                                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <Run Text="，支持批量添加 MP4 / MKV / AVI / MOV / WebM" />
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- 转换队列 -->
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE8FD;" FontSize="18" Margin="0,0,8,0"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="转换队列" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                                <CheckBox Grid.Column="2" Content="全选" Margin="12,0,0,0" MinWidth="0" Padding="6,0,10,0"
                                          VerticalAlignment="Center" FontSize="12"
                                          IsChecked="{x:Bind ViewModel.AllSelected, Mode=TwoWay}"
                                          AutomationProperties.Name="全选队列项" AutomationProperties.AutomationId="SelectAllCheck" />
                                <Button Grid.Column="4" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,0"
                                        Click="PickFileButton_Click"
                                        AutomationProperties.Name="添加文件" AutomationProperties.AutomationId="AddFilesButton">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="添加文件" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.QueueCountText, Mode=OneWay}"
                                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>

                            <ListView SelectionMode="Single"
                                      ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                                      ItemContainerStyle="{StaticResource QueueItemContainerStyle}"
                                      ScrollViewer.VerticalScrollMode="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                      Visibility="{x:Bind ViewModel.QueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverse}}"
                                      AutomationProperties.Name="转换队列">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:QueueItem">
                                        <Border Background="{ThemeResource AppCardBackground}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,8">
                                            <Grid Padding="12,14" ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                                          MinWidth="0" VerticalAlignment="Center"
                                                          Margin="0,0,2,0"
                                                          AutomationProperties.Name="参与转换" />

                                                <!-- 缩略图占位：模型没有逐项缩略图，用按文件名取色的柔和色块 + 时长角标 -->
                                                <Border Grid.Column="1" Width="96" Height="56" CornerRadius="4"
                                                        VerticalAlignment="Top"
                                                        Background="{Binding Converter={StaticResource ThumbnailBrush}}">
                                                    <Grid>
                                                        <FontIcon Glyph="&#xE8B2;" FontSize="22" Foreground="White" Opacity="0.9" />
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                Margin="0,0,4,3" Padding="4,0" CornerRadius="3"
                                                                Background="#8C000000"
                                                                Visibility="{x:Bind DurationBadgeText, Converter={StaticResource StringToVisibility}, Mode=OneWay}">
                                                            <TextBlock Text="{x:Bind DurationBadgeText, Mode=OneWay}"
                                                                       FontSize="10" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="14"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind InputPath, Mode=OneWay}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{x:Bind MetaPrefix, Mode=OneWay}" FontSize="12"
                                                                   Foreground="{ThemeResource AppSubtleText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="→" FontSize="12"
                                                                   Foreground="{ThemeResource AppSubtleText}" />
                                                        <TextBlock Text="{x:Bind TargetSummary, Mode=OneWay}" FontSize="12"
                                                                   Foreground="{ThemeResource AppSubtleText}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Grid ColumnSpacing="8" Margin="0,2,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Style="{StaticResource BadgeBorderStyle}"
                                                                HorizontalAlignment="Left"
                                                                Background="{x:Bind State, Converter={StaticResource StateToBadgeBrush}, Mode=OneWay}">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <FontIcon Glyph="{x:Bind State, Converter={StaticResource StateToGlyph}, Mode=OneWay}"
                                                                          FontSize="13" VerticalAlignment="Center"
                                                                          Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="12"
                                                                           FontWeight="SemiBold" VerticalAlignment="Center"
                                                                           Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- 失败原因紧跟徽章：危险色、省略号、悬停看全文 -->
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Error, Mode=OneWay}" FontSize="12"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{ThemeResource AppDangerForeground}"
                                                                   Visibility="{x:Bind Error, Converter={StaticResource StringToVisibility}, Mode=OneWay}"
                                                                   ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}" />
                                                    </Grid>
                                                    <!-- 进度条只在转换中显示（IsNotConverting 取反） -->
                                                    <ProgressBar Style="{StaticResource ThinProgressBarStyle}" Maximum="100"
                                                                 Value="{x:Bind ProgressValue, Mode=OneWay}" Margin="0,4,0,0"
                                                                 Visibility="{x:Bind IsNotConverting, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverse}}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SubtleIconButtonStyle}" Width="26" Height="26"
                                                            Click="MoveQueueItemUpButton_Click"
                                                            ToolTipService.ToolTip="上移"
                                                            AutomationProperties.Name="上移该队列项"
                                                            AutomationProperties.AutomationId="MoveUpButton">
                                                        <FontIcon Glyph="&#xE74A;" FontSize="13" />
                                                    </Button>
                                                    <Button Style="{StaticResource SubtleIconButtonStyle}" Width="26" Height="26"
                                                            Click="MoveQueueItemDownButton_Click"
                                                            ToolTipService.ToolTip="下移"
                                                            AutomationProperties.Name="下移该队列项"
                                                            AutomationProperties.AutomationId="MoveDownButton">
                                                        <FontIcon Glyph="&#xE74B;" FontSize="13" />
                                                    </Button>
                                                    <Button Style="{StaticResource DangerHoverIconButtonStyle}"
                                                            VerticalAlignment="Center"
                                                            Click="RemoveQueueItemButton_Click"
                                                            ToolTipService.ToolTip="从队列移除"
                                                            AutomationProperties.Name="移除该队列项">
                                                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 空态 -->
                            <Grid MinHeight="120"
                                  Visibility="{x:Bind ViewModel.QueueEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4 3"
                                           Stroke="{ThemeResource AppDropzoneStroke}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <FontIcon Glyph="&#xE714;" FontSize="36" Opacity="0.7" HorizontalAlignment="Center" />
                                    <TextBlock Text="队列为空" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource AppSubtleText}" />
                                    <TextBlock Text="将视频拖入上方区域，或点击添加文件" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{ThemeResource AppSubtleText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- 媒体信息：默认折叠，展开后是单个选中文件的完整信息（缩略图 + 十项字段） -->
                        <Expander HorizontalAlignment="Stretch" AutomationProperties.Name="媒体信息"
                                  Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <TextBlock Text="媒体信息" Style="{StaticResource CardTitleStyle}" />
                            </Expander.Header>
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="320" Height="180" CornerRadius="4"
                                            VerticalAlignment="Top"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                                        <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                                        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap">
                                            <Run Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="11"
                                                   Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="缩略图时间点" FontSize="11" Opacity="0.6"
                                               VerticalAlignment="Center" />
                                    <ctl:NoWheelNumberBox Grid.Column="1" Value="{x:Bind ViewModel.ThumbnailPosition, Mode=TwoWay}"
                                        Minimum="0" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                        AutomationProperties.Name="缩略图时间点" />
                                    <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="7,3" FontSize="11"
                                            Command="{x:Bind ViewModel.CaptureThumbnailCommand, Mode=OneWay}"
                                            ToolTipService.ToolTip="按当前时间点重新截取缩略图"
                                            AutomationProperties.Name="重新截取缩略图" AutomationProperties.AutomationId="RecaptureButton">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="11" />
                                            <TextBlock Text="重新截取" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="24" RowSpacing="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="大小" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="容器格式" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.ContainerText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="时长" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="分辨率" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="帧率" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="视频编码" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="{x:Bind ViewModel.VideoCodecText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="音频编码" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.AudioCodecText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="声道数" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="3" Text="{x:Bind ViewModel.AudioChannelsText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="总码率" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.BitRateText, Mode=OneWay}" FontSize="12" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="输出路径" Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <!-- 右列：输出设置面板（粘性置顶：VerticalAlignment=Top） -->
                    <Border x:Name="SettingsPanel" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top"
                            Style="{StaticResource CardBorderStyle}" Padding="0">
                        <StackPanel>
                            <Grid Style="{StaticResource CardHeaderStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE9E9;" FontSize="20" Margin="0,0,10,0"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                          VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="输出设置" Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="应用于所有待转换文件"
                                           Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Padding="18,4,18,0">
                                <!-- 输出格式 -->
                                <Grid Style="{StaticResource SetRowStyle}" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE786;" FontSize="16"
                                                  Foreground="{ThemeResource AppSubtleText}" VerticalAlignment="Center" />
                                        <TextBlock Text="输出格式" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ctl:NoWheelComboBox Grid.Column="1" MinWidth="132" Height="32" FontSize="14"
                                        ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                        AutomationProperties.Name="输出格式">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource ExtensionLabel}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ctl:NoWheelComboBox>
                                </Grid>

                                <!-- 质量 -->
                                <Grid Style="{StaticResource SetRowStyle}" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9E9;" FontSize="16"
                                                  Foreground="{ThemeResource AppSubtleText}" VerticalAlignment="Center" />
                                        <TextBlock Text="质量" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ctl:NoWheelSlider Grid.Column="1" Width="120" Minimum="0" Maximum="51"
                                        Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" VerticalAlignment="Center"
                                        AutomationProperties.Name="质量" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Crf, Mode=OneWay}" FontSize="14"
                                               FontWeight="SemiBold" MinWidth="24" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- 分辨率 -->
                                <Grid Style="{StaticResource SetRowStyle}" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16"
                                                  Foreground="{ThemeResource AppSubtleText}" VerticalAlignment="Center" />
                                        <TextBlock Text="分辨率" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <ctl:NoWheelComboBox Grid.Column="1" MinWidth="132" Height="32" FontSize="14"
                                        ItemsSource="{x:Bind ViewModel.ScaleOptions, Mode=OneWay}"
                                        SelectedItem="{x:Bind ViewModel.SelectedScaleOption, Mode=TwoWay}"
                                        AutomationProperties.Name="分辨率">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ScaleOption" xmlns:vm="using:VideoConverter.ViewModels">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ctl:NoWheelComboBox>
                                </Grid>

                                <!-- 软件编码：当前语义是"强制软件编码"，不是加速开关 -->
                                <Grid Style="{StaticResource SetRowStyle}" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE945;" FontSize="16"
                                                      Foreground="{ThemeResource AppSubtleText}" VerticalAlignment="Center" />
                                            <TextBlock Text="强制软件编码" FontSize="14" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="忽略硬件探测结果，改用软件编码" FontSize="11"
                                                   Foreground="{ThemeResource AppSubtleText}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" MinWidth="0"
                                                  IsOn="{x:Bind ViewModel.ForceSoftware, Mode=TwoWay}"
                                                  AutomationProperties.Name="强制软件编码" />
                                </Grid>

                                <!-- 输出目录 -->
                                <Grid Style="{StaticResource SetRowStyle}" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="16"
                                                  Foreground="{ThemeResource AppSubtleText}" VerticalAlignment="Center" />
                                        <TextBlock Text="输出目录" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}"
                                                Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                Command="{x:Bind ViewModel.BrowseOutputDirectoryCommand, Mode=OneWay}"
                                                ToolTipService.ToolTip="选择输出目录"
                                                AutomationProperties.Name="选择输出目录"
                                                AutomationProperties.AutomationId="PanelBrowseOutputDirButton">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="18" />
                                        </Button>
                                        <TextBlock Text="{x:Bind ViewModel.OutputDirectoryDisplay, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextStyle}" MaxWidth="200"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   VerticalAlignment="Center"
                                                   ToolTipService.ToolTip="{x:Bind ViewModel.OutputDirectoryDisplay, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 高级选项 -->
                            <Expander HorizontalAlignment="Stretch" AutomationProperties.Name="高级选项">
                                <Expander.Header>
                                    <TextBlock Text="高级选项" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{ThemeResource AppSubtleText}" />
                                </Expander.Header>
                                <StackPanel Padding="18,0,18,10">
                                    <Grid Style="{StaticResource SetRowStyle}" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="音频码率" FontSize="14" VerticalAlignment="Center" />
                                        <ctl:NoWheelNumberBox Grid.Column="1" MinWidth="132" Height="32"
                                            Value="{x:Bind ViewModel.AudioBitrate, Mode=TwoWay}"
                                            Minimum="32" Maximum="512" SmallChange="16" LargeChange="64"
                                            SpinButtonPlacementMode="Compact" AutomationProperties.Name="音频码率" />
                                    </Grid>
                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,8"
                                            CornerRadius="4" Margin="0,12,0,0">
                                        <TextBlock Text="{x:Bind ViewModel.ParameterSummary, Mode=OneWay}" FontSize="12"
                                                   Foreground="{x:Bind ViewModel.ParameterSummaryBrush, Mode=OneWay}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- 面板操作：整行堆叠 -->
                            <StackPanel Padding="18,12,18,16" Spacing="8">
                                <Button Style="{StaticResource LargePrimaryButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanStartConvert, Mode=OneWay}"
                                        AutomationProperties.Name="开始转换" AutomationProperties.AutomationId="ConvertButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE768;" FontSize="16" />
                                        <TextBlock Text="开始转换" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource LargeButtonStyle}" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.ClearQueueCommand, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.QueueEmpty, Mode=OneWay, Converter={StaticResource InverseBoolToBoolean}}"
                                        AutomationProperties.Name="清空队列" AutomationProperties.AutomationId="ClearQueueButton">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                        <TextBlock Text="清空队列" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
