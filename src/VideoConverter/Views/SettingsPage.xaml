<Page
    x:Class="VideoConverter.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Style="{StaticResource PageScrollViewerStyle}" Padding="20,16">
        <StackPanel MaxWidth="720" Spacing="12">

            <!-- 编码器 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="编码器" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.EncoderStatusText, Mode=OneWay}"
                               Style="{StaticResource SubtleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox Content="强制使用软件编码"
                                  IsChecked="{x:Bind ViewModel.ForceSoftware, Mode=TwoWay}"
                                  FontSize="12" AutomationProperties.Name="强制使用软件编码" />
                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Command="{x:Bind ViewModel.ReprobeCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanReprobe, Mode=OneWay}"
                                AutomationProperties.Name="重新探测编码器">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                <TextBlock Text="重新探测" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="启动时会真实试编码探测硬件编码器；结果异常时会自动回退软件编码。"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ffmpeg -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="ffmpeg" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}"
                               Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="查找顺序：应用目录 -> 系统 PATH。二进制随应用分发。"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                            Visibility="{x:Bind ViewModel.FfmpegWarningVisibility, Mode=OneWay}"
                            Command="{x:Bind ViewModel.OpenFfmpegDownloadPageCommand, Mode=OneWay}"
                            AutomationProperties.Name="获取 ffmpeg">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE896;" FontSize="12" />
                            <TextBlock Text="获取 ffmpeg" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 输出 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="输出" Style="{StaticResource SectionHeaderStyle}" />
                    <TextBlock Text="输出目录（留空 = 与源文件同目录）" Style="{StaticResource SubtleTextStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="输出目录" AutomationProperties.AutomationId="OutputDirBox" />
                        <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Command="{x:Bind ViewModel.BrowseOutputDirectoryCommand, Mode=OneWay}"
                                ToolTipService.ToolTip="选择输出目录" AutomationProperties.AutomationId="BrowseOutputDirButton">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE8DA;" FontSize="12" />
                                <TextBlock Text="浏览" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
