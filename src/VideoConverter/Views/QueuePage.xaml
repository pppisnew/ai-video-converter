<Page
    x:Class="VideoConverter.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VideoConverter.Core.Models">

    <!-- 统一内容容器：内边距 24/20，宽度等于视口宽度（不设上限，避免宽窗溢出） -->
    <Grid Padding="24,20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 实时汇总（页标题由窗口头部承担） -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.QueueSummaryText, Mode=OneWay}"
                       Style="{StaticResource SubtleTextStyle}" VerticalAlignment="Center" />
        </Grid>

        <!-- 主操作：一键开始 + 取消 + 全选 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
            <CheckBox Content="全选"
                      IsChecked="{x:Bind ViewModel.AllSelected, Mode=TwoWay}"
                      MinWidth="0" Padding="6,0,10,0" VerticalAlignment="Center" FontSize="12"
                      AutomationProperties.Name="全选队列项" AutomationProperties.AutomationId="SelectAllCheck" />
            <Button Style="{StaticResource AccentButtonStyle}" Padding="12,6"
                    Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanStartConvert, Mode=OneWay}"
                    AutomationProperties.Name="开始转换" AutomationProperties.AutomationId="ConvertButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE768;" FontSize="13" />
                    <TextBlock Text="开始转换" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.CancelCurrentCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    ToolTipService.ToolTip="取消当前任务，队列继续" AutomationProperties.Name="取消当前">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                    <TextBlock Text="取消当前" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.CancelAllCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    ToolTipService.ToolTip="停止整个队列" AutomationProperties.Name="全部停止">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE73B;" FontSize="12" />
                    <TextBlock Text="全部停止" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 队列管理：排序 / 删除 / 清除 / 重试 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
            <Button Style="{StaticResource SubtleIconButtonStyle}"
                    Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                    ToolTipService.ToolTip="上移选中项" AutomationProperties.Name="上移" AutomationProperties.AutomationId="MoveUpButton">
                <FontIcon Glyph="&#xE74A;" FontSize="13" />
            </Button>
            <Button Style="{StaticResource SubtleIconButtonStyle}"
                    Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                    ToolTipService.ToolTip="下移选中项" AutomationProperties.Name="下移" AutomationProperties.AutomationId="MoveDownButton">
                <FontIcon Glyph="&#xE74B;" FontSize="13" />
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.RemoveSelectedCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                    ToolTipService.ToolTip="移除选中队列项" AutomationProperties.Name="移除选中队列项">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                    <TextBlock Text="移除" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.RetryFailedCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.HasFailedItems, Mode=OneWay}"
                    ToolTipService.ToolTip="重试全部失败任务" AutomationProperties.Name="重试失败项">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    <TextBlock Text="重试失败项" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.ClearCompletedCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="清除所有已完成任务" AutomationProperties.Name="清除已完成任务">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE894;" FontSize="12" />
                    <TextBlock Text="清除已完成" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButtonStyle}"
                    Command="{x:Bind ViewModel.ClearQueueCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="清空整个队列" AutomationProperties.Name="清空队列" AutomationProperties.AutomationId="ClearQueueButton">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    <TextBlock Text="清空队列" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- 进度 -->
        <Grid Grid.Row="3" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Grid.Row="0" Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" />
            <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}"
                       Style="{StaticResource SubtleTextStyle}" TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- 队列列表（卡片化） + 空态提示 -->
        <Grid Grid.Row="4">
            <ListView SelectionMode="Single"
                      ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                      ItemContainerStyle="{StaticResource QueueItemContainerStyle}"
                      AutomationProperties.Name="转换队列">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QueueItem">
                        <Grid Padding="12,10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      MinWidth="0" VerticalAlignment="Center"
                                      AutomationProperties.Name="参与转换" />
                            <FontIcon Grid.Column="1"
                                      Glyph="{x:Bind State, Converter={StaticResource StateToGlyph}, Mode=OneWay}"
                                      Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}"
                                      FontSize="14" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind InputPath, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind TargetSummary, Mode=OneWay}" FontSize="11" Opacity="0.5" />
                                <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="11"
                                           Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Error, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButtonStyle}" Padding="7,3" FontSize="11"
                                        Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                        Click="RevealOutputButton_Click"
                                        AutomationProperties.Name="定位输出文件">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="11" />
                                        <TextBlock Text="定位" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleIconButtonStyle}" Padding="6,3"
                                        Visibility="{x:Bind IsNotConverting, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                        Click="RemoveItemButton_Click"
                                        ToolTipService.ToolTip="从队列移除"
                                        AutomationProperties.Name="移除该队列项">
                                    <FontIcon Glyph="&#xE711;" FontSize="11" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空态提示（不拦截点击） -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.QueueEmpty, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <FontIcon Glyph="&#xE8A5;" FontSize="28" HorizontalAlignment="Center" Opacity="0.4" />
                <TextBlock Text="队列为空" FontSize="14" HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock Text="在转换页选择文件，或把视频拖拽到窗口任意位置" FontSize="12" HorizontalAlignment="Center" Opacity="0.4" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
