<Page
    x:Class="VideoConverter.Views.QueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VideoConverter.Core.Models">

    <!-- 任务列表（监控页）：统计卡 + 状态筛选 + 任务行；开始转换在转换页 -->
    <Grid Padding="24,20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Text="任务列表" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="管理全部转换任务：查看进度、取消当前或重试失败项。" />
        </StackPanel>

        <!-- 统计卡：宽窗 4 列，窄窗 2 列（断点在代码后置里切换） -->
        <Grid x:Name="StatGrid" Grid.Row="1" ColumnSpacing="14" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="StatColumn3" Width="*" />
                <ColumnDefinition x:Name="StatColumn4" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="StatAllCard" Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="{ThemeResource AppAccentSoftBackground}">
                        <FontIcon Glyph="&#xE8FD;" FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.TotalTaskCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="全部任务" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="StatRunningCard" Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="{ThemeResource AppAccentSoftBackground}">
                        <FontIcon Glyph="&#xE768;" FontSize="20"
                                  Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.RunningTaskCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="转换中" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="StatCompletedCard" Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="{ThemeResource AppSuccessSoftBackground}">
                        <FontIcon Glyph="&#xE73E;" FontSize="20"
                                  Foreground="{ThemeResource AppSuccessForeground}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.CompletedTaskCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="已完成" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="StatFailedCard" Grid.Row="0" Grid.Column="3"
                    Style="{StaticResource CardBorderStyle}" Padding="18,16">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                            Background="{ThemeResource AppDangerSoftBackground}">
                        <FontIcon Glyph="&#xEA39;" FontSize="20"
                                  Foreground="{ThemeResource AppDangerForeground}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.FailedTaskCount, Mode=OneWay}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="失败" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态筛选 + 列表操作 -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                <Button Content="全部" Command="{x:Bind ViewModel.SetTaskFilterCommand}" CommandParameter="All"
                        Style="{x:Bind ViewModel.TaskFilter, Mode=OneWay, Converter={StaticResource FilterChipStyle}, ConverterParameter=All}"
                        AutomationProperties.Name="筛选：全部" />
                <Button Content="转换中" Command="{x:Bind ViewModel.SetTaskFilterCommand}" CommandParameter="Converting"
                        Style="{x:Bind ViewModel.TaskFilter, Mode=OneWay, Converter={StaticResource FilterChipStyle}, ConverterParameter=Converting}"
                        AutomationProperties.Name="筛选：转换中" />
                <Button Content="等待中" Command="{x:Bind ViewModel.SetTaskFilterCommand}" CommandParameter="Pending"
                        Style="{x:Bind ViewModel.TaskFilter, Mode=OneWay, Converter={StaticResource FilterChipStyle}, ConverterParameter=Pending}"
                        AutomationProperties.Name="筛选：等待中" />
                <Button Content="已完成" Command="{x:Bind ViewModel.SetTaskFilterCommand}" CommandParameter="Completed"
                        Style="{x:Bind ViewModel.TaskFilter, Mode=OneWay, Converter={StaticResource FilterChipStyle}, ConverterParameter=Completed}"
                        AutomationProperties.Name="筛选：已完成" />
                <Button Content="失败" Command="{x:Bind ViewModel.SetTaskFilterCommand}" CommandParameter="Failed"
                        Style="{x:Bind ViewModel.TaskFilter, Mode=OneWay, Converter={StaticResource FilterChipStyle}, ConverterParameter=Failed}"
                        AutomationProperties.Name="筛选：失败" />
            </StackPanel>
            <!-- 全部停止：整队停摆（区别于行内"取消该任务"只停当前这一项）。
                 只在队列运行中出现，否则它既不可用也没有意义。 -->
            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Content="全部停止"
                    Foreground="{ThemeResource AppDangerForeground}"
                    Command="{x:Bind ViewModel.CancelAllCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="停止当前任务，其余任务保持等待中"
                    AutomationProperties.Name="全部停止"
                    AutomationProperties.AutomationId="StopAllButton" />
            <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Content="重试失败项"
                    Command="{x:Bind ViewModel.RetryFailedCommand, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasFailedItems, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.Name="重试失败项" />
            <Button Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Content="清除已完成"
                    Command="{x:Bind ViewModel.ClearCompletedCommand, Mode=OneWay}"
                    AutomationProperties.Name="清除已完成任务" />
        </Grid>

        <!-- 任务行：占满剩余高度并**自己滚动**（页头/统计卡/筛选栏固定不动）。
             本页根是 Grid 而不是 ScrollViewer，所以列表必须自己滚，
             否则任务数超过一屏时后面的行会被直接裁掉、滚不到。 -->
        <Grid Grid.Row="3">
            <ListView SelectionMode="None"
                      ItemsSource="{x:Bind ViewModel.FilteredTasks, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource QueueItemContainerStyle}"
                      ScrollViewer.VerticalScrollMode="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="任务列表">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:QueueItem">
                        <Border Background="{ThemeResource AppCardBackground}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,8" Padding="14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 缩略图：真实截帧（后台截好后回填 ThumbnailPath）盖在彩色占位块上；
                                     帧还没截到时只显示色块 + 时长角标，这是设计中的兜底 -->
                                <Border Grid.Column="0" Width="96" Height="56" CornerRadius="4"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE8B2;" FontSize="28" Foreground="White" Opacity="0.9" />
                                        <Image Source="{Binding ThumbnailPath, Mode=OneWay, Converter={StaticResource PathToImageSource}}"
                                               Stretch="Uniform" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,4,3" Padding="4,0" CornerRadius="3"
                                                Background="#8C000000"
                                                Visibility="{x:Bind DurationBadgeText, Converter={StaticResource StringToVisibility}, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind DurationBadgeText, Mode=OneWay}"
                                                       FontSize="10" Foreground="White" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind InputPath, Mode=OneWay}" />
                                    <!-- 单个 TextBlock：超宽只末端截断，
                                         不会把靠后的元素挤出视野 -->
                                    <TextBlock Text="{x:Bind MetaLine, Mode=OneWay}" FontSize="12"
                                               Foreground="{ThemeResource AppSubtleText}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind MetaLine, Mode=OneWay}" />
                                    <Grid ColumnSpacing="10" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MaxWidth="340" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressBar Grid.Column="0" Style="{StaticResource ThinProgressBarStyle}"
                                                     Maximum="100" Value="{x:Bind ProgressValue, Mode=OneWay}"
                                                     VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind ProgressPercentText, Mode=OneWay}"
                                                   FontSize="12" MinWidth="34" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppSubtleText}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind ProgressDetail, Mode=OneWay}"
                                                   FontSize="12" MinWidth="120" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Border Grid.Column="2" Style="{StaticResource BadgeBorderStyle}"
                                            Background="{x:Bind State, Converter={StaticResource StateToBadgeBrush}, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="{x:Bind State, Converter={StaticResource StateToGlyph}, Mode=OneWay}"
                                                      FontSize="13" VerticalAlignment="Center"
                                                      Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind StateLabel, Mode=OneWay}" FontSize="12"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{x:Bind State, Converter={StaticResource StateToBrush}, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- 参数来源：这一行是逐项覆盖，还是跟随右侧面板 -->
                                    <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource AppAccentSoftBackground}"
                                            Visibility="{x:Bind HasOverride, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="已覆盖" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppAccentForeground}" />
                                    </Border>
                                    <Border Style="{StaticResource BadgeBorderStyle}" Background="{ThemeResource AppBadgeNeutralBackground}"
                                            Visibility="{x:Bind HasOverride, Mode=OneWay, Converter={StaticResource BoolToVisibilityInverse}}">
                                        <TextBlock Text="继承全局" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AppSubtleText}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Visibility="{x:Bind IsCompleted, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                            Click="RevealOutputButton_Click"
                                            ToolTipService.ToolTip="在资源管理器中定位输出文件"
                                            AutomationProperties.Name="定位输出文件">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="18" />
                                    </Button>
                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Visibility="{x:Bind IsFailed, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                            Click="RetryItemButton_Click"
                                            ToolTipService.ToolTip="重新加入等待队列"
                                            AutomationProperties.Name="重试该任务">
                                        <FontIcon Glyph="&#xE72C;" FontSize="18" />
                                    </Button>
                                    <Button Style="{StaticResource SubtleIconButtonStyle}"
                                            Visibility="{x:Bind IsConverting, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                                            Click="CancelItemButton_Click"
                                            ToolTipService.ToolTip="取消这个任务"
                                            AutomationProperties.Name="取消该任务"
                                            AutomationProperties.AutomationId="CancelTaskButton">
                                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                                    </Button>
                                    <Button Style="{StaticResource DangerIconButtonStyle}"
                                            Click="RemoveItemButton_Click"
                                            ToolTipService.ToolTip="从队列移除"
                                            AutomationProperties.Name="移除该队列项">
                                        <FontIcon Glyph="&#xE711;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 空态（不拦截点击） -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" IsHitTestVisible="False"
                        Visibility="{x:Bind ViewModel.TaskListEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE8FD;" FontSize="36" HorizontalAlignment="Center" Opacity="0.6" />
                <TextBlock Text="暂无任务" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                           Foreground="{ThemeResource AppSubtleText}" />
                <TextBlock Text="当前筛选条件下没有任务，或回到转换页添加视频文件" FontSize="12"
                           HorizontalAlignment="Center" Foreground="{ThemeResource AppSubtleText}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
