<Window
    x:Class="VideoConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="视频格式转换器">

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" DragLeave="Root_DragLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,10,16,10" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 当前页标题：由 Nav_SelectionChanged 更新；应用名交给 OS 标题栏，不再重复 -->
            <TextBlock x:Name="HeaderTitle" Text="转换" Style="{StaticResource PageTitleStyle}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- 紧凑状态药丸：圆点 + 短状态，完整版本/来源/路径走 ToolTip -->
                <Border CornerRadius="12" Padding="10,4"
                        Background="{ThemeResource AppCardBackground}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTipService.ToolTip="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <InfoBadge x:Name="FfmpegBadge" VerticalAlignment="Center"
                                   Foreground="{x:Bind ViewModel.FfmpegStatusBrush, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.FfmpegShortStatus, Mode=OneWay}"
                                   FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Content="获取 ffmpeg" Padding="10,3" FontSize="12"
                        Visibility="{x:Bind ViewModel.FfmpegWarningVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenFfmpegDownloadPageCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="600"
                        ExpandedModeThresholdWidth="1000"
                        OpenPaneLength="200"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="转换" Tag="Convert" IsSelected="True"
                                    AutomationProperties.AutomationId="NavConvert">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="队列" Tag="Queue"
                                    AutomationProperties.AutomationId="NavQueue">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.ActiveQueueCount, Mode=OneWay}"
                       Visibility="{x:Bind ViewModel.QueueBadgeVisibility, Mode=OneWay}" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="Settings"
                                    AutomationProperties.AutomationId="NavSettings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <Border Grid.Row="2" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>
