<Window
    x:Class="VideoConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="视频格式转换器"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + ffmpeg 状态 -->
        <Grid Grid.Row="0" Padding="20,14,20,14" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="视频格式转换器" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE90E;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{x:Bind ViewModel.FfmpegStatusBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.85" />
                <Button Content="获取 ffmpeg" Padding="10,3" FontSize="12" AutomationProperties.Name="获取 ffmpeg"
                        Visibility="{x:Bind ViewModel.FfmpegWarningVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenFfmpegDownloadPageCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- 主体：文件区 / 信息区 / 转换区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 左列：文件选择 -->
            <StackPanel Grid.Column="0" Padding="16" Spacing="12">
                <TextBlock Text="视频文件" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                        Click="PickFileButton_Click" AutomationProperties.Name="选择视频文件" AutomationProperties.AutomationId="PickFileButton">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock Text="选择视频文件" />
                    </StackPanel>
                </Button>

                <Border Height="150" AllowDrop="True"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4"
                        DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="26" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="或将视频拖拽到此处" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Text="文件名" FontSize="11" Opacity="0.6" />
                    <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                    <TextBlock Text="大小" FontSize="11" Opacity="0.6" Margin="0,8,0,0" />
                    <TextBlock Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 中列：媒体信息 + 缩略图 -->
            <ScrollViewer Grid.Column="1" Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="媒体信息" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="容器格式" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.ContainerText, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="时长" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="分辨率" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="帧率" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="视频编码" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.VideoCodecText, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="音频编码" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.AudioCodecText, Mode=OneWay}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="声道数" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.AudioChannelsText, Mode=OneWay}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="总码率" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.BitRateText, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Text="缩略图" FontSize="13" FontWeight="SemiBold" Opacity="0.7" Margin="0,8,0,0" />
                    <Border Height="200" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="4">
                        <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                    </Border>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="截取时间点（秒）" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        <NumberBox Grid.Column="1" Value="{x:Bind ViewModel.ThumbnailPosition, Mode=TwoWay}"
                                   SmallChange="1" LargeChange="5" Minimum="0" SpinButtonPlacementMode="Compact" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.CaptureThumbnailCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}"
                                ToolTipService.ToolTip="按当前时间点重新截取缩略图" AutomationProperties.Name="重新截取缩略图" AutomationProperties.AutomationId="RecaptureThumbnailButton">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="重新截取" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Right"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 右列：转换 -->
            <ContentControl Grid.Column="2" Padding="16" IsEnabled="{x:Bind ViewModel.FfmpegReady, Mode=OneWay}">
              <StackPanel Spacing="12">
                <TextBlock Text="目标格式" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
                <ListView MaxHeight="220" SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.Presets, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ConvertPreset" xmlns:models="using:VideoConverter.Core.Models">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Text="输出路径" FontSize="13" FontWeight="SemiBold" Opacity="0.7" Margin="0,4,0,0" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="默认与源文件同目录" />
                    <Button Grid.Column="1" Click="BrowseOutputButton_Click" AutomationProperties.Name="选择输出路径" AutomationProperties.AutomationId="BrowseOutputButton"
                            ToolTipService.ToolTip="选择输出位置">
                        <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                    </Button>
                </Grid>

                <Grid ColumnSpacing="8" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalContentAlignment="Center" Padding="0,10"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}" AutomationProperties.Name="开始转换" AutomationProperties.AutomationId="ConvertButton"
                            IsEnabled="{x:Bind ViewModel.HasVideo, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="开始转换" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Padding="12,10"
                            Command="{x:Bind ViewModel.CancelConvertCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsConverting, Mode=OneWay}"
                            ToolTipService.ToolTip="取消当前转换" AutomationProperties.Name="取消转换" AutomationProperties.AutomationId="CancelButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                            <TextBlock Text="取消" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6"
                             Margin="0,4,0,0" />
                <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>


