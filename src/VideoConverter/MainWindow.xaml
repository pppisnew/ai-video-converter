<Window
    x:Class="VideoConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VideoConverter.ViewModels"
    xmlns:ctl="using:VideoConverter.Controls"
    Title="视频格式转换器">

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" DragLeave="Root_DragLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Padding="20,14,20,14" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="视频格式转换器" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE90E;" FontSize="14" VerticalAlignment="Center"
                          Foreground="{x:Bind ViewModel.FfmpegStatusBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.85" />
                <Button Content="获取 ffmpeg" Padding="10,3" FontSize="12" AutomationProperties.AutomationId="GetFfmpegButton"
                        Visibility="{x:Bind ViewModel.FfmpegWarningVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenFfmpegDownloadPageCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左列：入队 + 队列 -->
            <StackPanel Grid.Column="0" Padding="16" Spacing="10">
                <TextBlock Text="视频文件" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,10"
                        AutomationProperties.Name="选择视频文件" AutomationProperties.AutomationId="PickFileButton"
                        Click="PickFileButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16" />
                        <TextBlock Text="选择视频文件（可多选）" />
                    </StackPanel>
                </Button>

                <Border x:Name="DropZone" Height="110"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                        <FontIcon Glyph="&#xE896;" FontSize="24" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="或将视频拖拽到此处" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="转换队列" FontSize="13" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="移除" Padding="8,3" FontSize="12"
                            Command="{x:Bind ViewModel.RemoveSelectedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                            AutomationProperties.Name="移除选中队列项" />
                    <Button Grid.Column="1" Content="清除已完成" Padding="8,3" FontSize="12" Margin="0,0,8,0"
                            Command="{x:Bind ViewModel.ClearCompletedCommand, Mode=OneWay}"
                            AutomationProperties.Name="清除已完成任务" />
                </Grid>

                <ListView MaxHeight="320" SelectionMode="Single"
                          ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          AutomationProperties.Name="转换队列">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueItem" xmlns:models="using:VideoConverter.Core.Models">
                            <Grid Padding="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 经典 Binding：x:Bind + Converter 的查找根是 Window（非 FrameworkElement）会编译失败 -->
                                <FontIcon Grid.Column="0" FontSize="14" VerticalAlignment="Center"
                                          Glyph="{Binding State, Converter={StaticResource StateToGlyph}}"
                                          Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind InputPath, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="11" Opacity="0.6"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="定位" Padding="6,2" FontSize="11"
                                        Visibility="{x:Bind IsCompleted, Mode=OneWay}"
                                        Click="RevealOutputButton_Click"
                                        AutomationProperties.Name="定位输出文件" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Left"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 中列：媒体信息 + 缩略图 -->
            <ScrollViewer Grid.Column="1" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="媒体信息" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="文件名" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="大小" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="容器格式" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ContainerText, Mode=OneWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="时长" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="分辨率" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="帧率" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" />
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="视频编码" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.VideoCodecText, Mode=OneWay}" />
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="音频编码" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.AudioCodecText, Mode=OneWay}" />
                        <TextBlock Grid.Row="8" Grid.Column="0" Text="声道数" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.AudioChannelsText, Mode=OneWay}" />
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="总码率" Opacity="0.6" FontSize="12" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind ViewModel.BitRateText, Mode=OneWay}" />
                    </Grid>

                    <TextBlock Text="缩略图" FontSize="13" FontWeight="SemiBold" Opacity="0.7" Margin="0,6,0,0" />
                    <Border Height="200" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                    </Border>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="截取时间点（秒）" VerticalAlignment="Center" FontSize="12" Opacity="0.7" />
                        <ctl:NoWheelNumberBox Grid.Column="1" Value="{x:Bind ViewModel.ThumbnailPosition, Mode=TwoWay}"
                                   SmallChange="1" LargeChange="5" Minimum="0" SpinButtonPlacementMode="Compact" />
                        <Button Grid.Column="2" Command="{x:Bind ViewModel.CaptureThumbnailCommand, Mode=OneWay}"
                                AutomationProperties.Name="重新截取缩略图" AutomationProperties.AutomationId="RecaptureButton"
                                ToolTipService.ToolTip="按当前时间点重新截取缩略图">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="重新截取" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="输出路径" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="1" Width="1" HorizontalAlignment="Right"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 右列：编码器状态 + 参数面板 -->
            <ContentControl Grid.Column="2" Padding="16" IsEnabled="{x:Bind ViewModel.FfmpegReady, Mode=OneWay}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <!-- 编码器状态卡 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="编码器" FontSize="13" FontWeight="SemiBold" Opacity="0.7" />
                                <TextBlock Text="{x:Bind ViewModel.EncoderStatusText, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" Opacity="0.85" />
                                <CheckBox Content="强制使用软件编码" IsChecked="{x:Bind ViewModel.ForceSoftware, Mode=TwoWay}"
                                          FontSize="12" AutomationProperties.Name="强制使用软件编码" AutomationProperties.AutomationId="ForceSoftwareCheck" />
                                <Button HorizontalAlignment="Left" Padding="10,4" FontSize="12"
                                        Command="{x:Bind ViewModel.ReprobeCommand, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanReprobe, Mode=OneWay}"
                                        AutomationProperties.Name="重新探测编码器">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock Text="重新探测" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- 参数面板 -->
                        <TextBlock Text="转换参数" FontSize="13" FontWeight="SemiBold" Opacity="0.7" Margin="0,4,0,0" />
                        <TextBlock Text="容器格式" FontSize="12" Opacity="0.6" />
                        <ctl:NoWheelComboBox ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="容器格式" AutomationProperties.AutomationId="ContainerCombo" />

                        <TextBlock Text="视频编码器" FontSize="12" Opacity="0.6" />
                        <ctl:NoWheelComboBox ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedEncoderOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="视频编码器" AutomationProperties.AutomationId="EncoderCombo">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EncoderOption" xmlns:vm="using:VideoConverter.ViewModels">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ctl:NoWheelComboBox>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="质量" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                            <ctl:NoWheelSlider Grid.Column="1" Minimum="0" Maximum="51" Value="{x:Bind ViewModel.Crf, Mode=TwoWay}"
                                    VerticalAlignment="Center" AutomationProperties.Name="质量" AutomationProperties.AutomationId="QualitySlider" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Crf, Mode=OneWay}" FontSize="12"
                                       VerticalAlignment="Center" MinWidth="24" />
                        </Grid>
                        <TextBlock Text="数值越小质量越高（0-51）" FontSize="11" Opacity="0.5" />

                        <TextBlock Text="分辨率" FontSize="12" Opacity="0.6" />
                        <ctl:NoWheelComboBox ItemsSource="{x:Bind ViewModel.ScaleOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedScaleOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" AutomationProperties.Name="分辨率" AutomationProperties.AutomationId="ScaleCombo">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ScaleOption" xmlns:vm="using:VideoConverter.ViewModels">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ctl:NoWheelComboBox>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="音频码率 (kbps)" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                            <ctl:NoWheelNumberBox Grid.Column="1" Value="{x:Bind ViewModel.AudioBitrate, Mode=TwoWay}"
                                       Minimum="32" Maximum="512" SmallChange="16" LargeChange="64"
                                       SpinButtonPlacementMode="Compact" AutomationProperties.Name="音频码率" AutomationProperties.AutomationId="AudioBitrateBox" />
                        </Grid>

                        <!-- 参数摘要 -->
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,8" CornerRadius="4">
                            <TextBlock Text="{x:Bind ViewModel.ParameterSummary, Mode=OneWay}" FontSize="12"
                                       TextWrapping="Wrap" Foreground="{x:Bind ViewModel.ParameterSummaryBrush, Mode=OneWay}" />
                        </Border>
                        <Button HorizontalAlignment="Right" Padding="10,4" FontSize="12"
                                Command="{x:Bind ViewModel.ResetParametersCommand, Mode=OneWay}"
                                AutomationProperties.AutomationId="ResetButton" AutomationProperties.Name="重置为默认">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                                <TextBlock Text="重置为默认" />
                            </StackPanel>
                        </Button>

                        <!-- 执行 -->
                        <Grid ColumnSpacing="8" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalContentAlignment="Center" Padding="0,10"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                                    AutomationProperties.Name="开始转换" AutomationProperties.AutomationId="ConvertButton">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                                    <TextBlock Text="开始转换" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Padding="12,10"
                                    Command="{x:Bind ViewModel.CancelCurrentCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                    ToolTipService.ToolTip="取消当前任务，队列继续" AutomationProperties.Name="取消当前">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    <TextBlock Text="取消当前" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Padding="12,10"
                                    Command="{x:Bind ViewModel.CancelAllCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                    ToolTipService.ToolTip="停止整个队列" AutomationProperties.Name="取消全部">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE73B;" FontSize="14" />
                                    <TextBlock Text="全部停止" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" />
                        <TextBlock Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>
