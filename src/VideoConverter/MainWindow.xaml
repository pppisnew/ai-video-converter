<Window
    x:Class="VideoConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:VideoConverter.ViewModels"
    xmlns:ctl="using:VideoConverter.Controls"
    Title="视频格式转换器">

    <Grid AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" DragLeave="Root_DragLeave">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + ffmpeg 状态 -->
        <Grid Grid.Row="0" Padding="20,12,20,12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE8B7;" FontSize="18" VerticalAlignment="Center" />
                <TextBlock Text="视频格式转换器" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <InfoBadge x:Name="FfmpegBadge" VerticalAlignment="Center"
                           Foreground="{x:Bind ViewModel.FfmpegStatusBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.FfmpegStatus, Mode=OneWay}" VerticalAlignment="Center"
                           FontSize="12" Opacity="0.85" />
                <Button Content="获取 ffmpeg" Padding="10,3" FontSize="12"
                        Visibility="{x:Bind ViewModel.FfmpegWarningVisibility, Mode=OneWay}"
                        Command="{x:Bind ViewModel.OpenFfmpegDownloadPageCommand, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左列：文件队列 -->
            <StackPanel Grid.Column="0" Padding="14" Spacing="10">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,9"
                        AutomationProperties.Name="选择视频文件" AutomationProperties.AutomationId="PickFileButton"
                        Click="PickFileButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="15" />
                        <TextBlock Text="选择视频文件（可多选）" />
                    </StackPanel>
                </Button>

                <Border x:Name="DropZone" Height="72"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                        <FontIcon Glyph="&#xE896;" FontSize="20" HorizontalAlignment="Center" Opacity="0.6" />
                        <TextBlock Text="或将视频拖拽到此处" HorizontalAlignment="Center" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="全选"
                              IsChecked="{x:Bind ViewModel.AllSelected, Mode=TwoWay}"
                              MinWidth="0" Padding="0,0,6,0" VerticalAlignment="Center" FontSize="12"
                              AutomationProperties.Name="全选队列项" AutomationProperties.AutomationId="SelectAllCheck" />
                    <TextBlock Grid.Column="1" Text="转换队列" FontSize="13" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="上移" Padding="5,2" FontSize="11" AutomationProperties.AutomationId="MoveUpButton"
                            Command="{x:Bind ViewModel.MoveUpCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                            ToolTipService.ToolTip="上移选中项" AutomationProperties.Name="上移" />
                    <Button Grid.Column="3" Content="下移" Padding="5,2" FontSize="11" AutomationProperties.AutomationId="MoveDownButton"
                            Command="{x:Bind ViewModel.MoveDownCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                            ToolTipService.ToolTip="下移选中项" AutomationProperties.Name="下移" />
                    <Button Grid.Column="4" Content="移除" Padding="5,2" FontSize="11"
                            Command="{x:Bind ViewModel.RemoveSelectedCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                            AutomationProperties.Name="移除选中队列项" />
                </Grid>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="清除已完成" Padding="5,2" FontSize="11"
                            Command="{x:Bind ViewModel.ClearCompletedCommand, Mode=OneWay}"
                            AutomationProperties.Name="清除已完成任务" />
                    <Button Grid.Column="1" Content="清空队列" Padding="5,2" FontSize="11" AutomationProperties.AutomationId="ClearQueueButton"
                            Command="{x:Bind ViewModel.ClearQueueCommand, Mode=OneWay}"
                            AutomationProperties.Name="清空队列" />
                </Grid>

                <ListView MaxHeight="460" SelectionMode="Single" VerticalAlignment="Top"
                          ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          AutomationProperties.Name="转换队列">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:QueueItem" xmlns:models="using:VideoConverter.Core.Models">
                            <Grid Padding="0,5" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" MinWidth="0"
                                          VerticalAlignment="Center" AutomationProperties.Name="参与转换" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{x:Bind FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind InputPath, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="11" Opacity="0.55"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- 右列：文件详情 + 转换设置 + 操作 -->
            <!-- 禁用横向滚动：内容必须适应视口宽度，窗口再窄也不会被裁切 -->
            <ScrollViewer Grid.Column="1" Padding="16"
                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12">

                    <!-- 当前文件卡片 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Height="120" Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="4" VerticalAlignment="Top">
                                <Image Source="{x:Bind ViewModel.Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.FileName, Mode=OneWay}" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.FileName, Mode=OneWay}" />
                                <TextBlock FontSize="12" Opacity="0.7">
                                    <Run Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" />
                                    <Run Text="  ·  " />
                                    <Run Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="11"
                                           Opacity="0.5" TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" />
                                <Grid ColumnSpacing="6" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="缩略图时间点" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                    <ctl:NoWheelNumberBox Grid.Column="1" Value="{x:Bind ViewModel.ThumbnailPosition, Mode=TwoWay}"
                                        Minimum="0" SmallChange="1" LargeChange="5" SpinButtonPlacementMode="Compact"
                                        AutomationProperties.Name="缩略图时间点" />
                                    <Button Grid.Column="2" Padding="6,3" FontSize="11"
                                            Command="{x:Bind ViewModel.CaptureThumbnailCommand, Mode=OneWay}"
                                            ToolTipService.ToolTip="按当前时间点重新截取缩略图"
                                            AutomationProperties.Name="重新截取缩略图" AutomationProperties.AutomationId="RecaptureButton">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                                            <TextBlock Text="重新截取" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Expander Margin="-12,4,-12,0" HorizontalAlignment="Left"
                                          AutomationProperties.Name="详细信息">
                                    <Expander.Header>
                                        <TextBlock Text="详细信息" FontSize="12" />
                                    </Expander.Header>
                                    <Grid ColumnSpacing="16" RowSpacing="6" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="64" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="大小" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.FileSizeText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="容器格式" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ContainerText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="时长" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="分辨率" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.ResolutionText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="帧率" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.FrameRateText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="视频编码" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.VideoCodecText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="音频编码" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.AudioCodecText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="7" Grid.Column="0" Text="声道数" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{x:Bind ViewModel.AudioChannelsText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="8" Grid.Column="0" Text="总码率" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{x:Bind ViewModel.BitRateText, Mode=OneWay}" FontSize="12" />
                                        <TextBlock Grid.Row="9" Grid.Column="0" Text="输出路径" Opacity="0.6" FontSize="12" />
                                        <TextBlock Grid.Row="9" Grid.Column="1" Text="{x:Bind ViewModel.OutputPathText, Mode=OneWay}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 转换设置卡片 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="10">
                            <TextBlock Text="转换设置" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="容器格式" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                <ctl:NoWheelComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.Containers, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                    AutomationProperties.Name="容器格式" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="视频编码器" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                <ctl:NoWheelComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                    ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedEncoderOption, Mode=TwoWay}"
                                    AutomationProperties.Name="视频编码器">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EncoderOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ctl:NoWheelComboBox>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="质量" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                <ctl:NoWheelSlider Grid.Column="1" Minimum="0" Maximum="51"
                                    Value="{x:Bind ViewModel.Crf, Mode=TwoWay}" VerticalAlignment="Center"
                                    AutomationProperties.Name="质量" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Crf, Mode=OneWay}" FontSize="12"
                                           VerticalAlignment="Center" MinWidth="24" />
                            </Grid>
                            <TextBlock Text="数值越小质量越高（0-51）" FontSize="11" Opacity="0.5" Margin="90,0,0,0" />

                            <Expander Margin="-16,0,-16,0" HorizontalAlignment="Stretch"
                                      AutomationProperties.Name="高级选项">
                                <Expander.Header>
                                    <TextBlock Text="高级选项" FontSize="12" />
                                </Expander.Header>
                                <StackPanel Spacing="10" Margin="0,4,0,0">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="分辨率" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                        <ctl:NoWheelComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                            ItemsSource="{x:Bind ViewModel.ScaleOptions, Mode=OneWay}"
                                            SelectedItem="{x:Bind ViewModel.SelectedScaleOption, Mode=TwoWay}"
                                            AutomationProperties.Name="分辨率">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ScaleOption">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ctl:NoWheelComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="音频码率" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                        <ctl:NoWheelNumberBox Grid.Column="1" HorizontalAlignment="Stretch"
                                            Value="{x:Bind ViewModel.AudioBitrate, Mode=TwoWay}"
                                            Minimum="32" Maximum="512" SmallChange="16" LargeChange="64"
                                            SpinButtonPlacementMode="Compact" AutomationProperties.Name="音频码率" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="输出目录" VerticalAlignment="Center" Opacity="0.7" FontSize="12" />
                                        <TextBox Grid.Column="1" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="输出目录" AutomationProperties.AutomationId="OutputDirBox" />
                                        <Button Grid.Column="2" Command="{x:Bind ViewModel.BrowseOutputDirectoryCommand, Mode=OneWay}"
                                                ToolTipService.ToolTip="选择输出目录" AutomationProperties.AutomationId="BrowseOutputDirButton">
                                            <FontIcon Glyph="&#xE8DA;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="留空 = 与源文件同目录" FontSize="11" Opacity="0.5" Margin="90,0,0,0" />
                                </StackPanel>
                            </Expander>

                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="10,8" CornerRadius="4">
                                <TextBlock Text="{x:Bind ViewModel.ParameterSummary, Mode=OneWay}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>
                            <Button HorizontalAlignment="Right" Padding="10,4" FontSize="12"
                                    Command="{x:Bind ViewModel.ResetParametersCommand, Mode=OneWay}"
                                    AutomationProperties.Name="重置为默认">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE777;" FontSize="13" />
                                    <TextBlock Text="重置为默认" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 编码器状态卡片 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="编码器" FontSize="14" FontWeight="SemiBold" Opacity="0.8" />
                            <TextBlock Text="{x:Bind ViewModel.EncoderStatusText, Mode=OneWay}" FontSize="12"
                                       Opacity="0.85" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox Content="强制使用软件编码"
                                          IsChecked="{x:Bind ViewModel.ForceSoftware, Mode=TwoWay}"
                                          FontSize="12" AutomationProperties.Name="强制使用软件编码" />
                                <Button Padding="10,4" FontSize="12"
                                        Command="{x:Bind ViewModel.ReprobeCommand, Mode=OneWay}"
                                        IsEnabled="{x:Bind ViewModel.CanReprobe, Mode=OneWay}"
                                        AutomationProperties.Name="重新探测编码器">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                                        <TextBlock Text="重新探测" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 操作区 -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" HorizontalContentAlignment="Center" Padding="0,10"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ConvertCommand, Mode=OneWay}"
                                AutomationProperties.Name="开始转换" AutomationProperties.AutomationId="ConvertButton">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="15" />
                                <TextBlock Text="开始转换" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Padding="12,10"
                                Command="{x:Bind ViewModel.CancelCurrentCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                ToolTipService.ToolTip="取消当前任务，队列继续" AutomationProperties.Name="取消当前">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE711;" FontSize="14" />
                                <TextBlock Text="取消当前" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Padding="12,10"
                                Command="{x:Bind ViewModel.CancelAllCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                                ToolTipService.ToolTip="停止整个队列" AutomationProperties.Name="全部停止">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE73B;" FontSize="14" />
                                <TextBlock Text="全部停止" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ProgressBar Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" Maximum="100" Height="6" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressSummary, Mode=OneWay}" FontSize="12" Opacity="0.7" />

                    <Button HorizontalAlignment="Left" Padding="10,4" FontSize="12"
                            Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RevealOutputCommand, Mode=OneWay}"
                            AutomationProperties.Name="定位输出文件">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8DA;" FontSize="13" />
                            <TextBlock Text="在资源管理器中定位输出文件" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{x:Bind ViewModel.StatusBrush, Mode=OneWay}" />
        </Border>
    </Grid>
</Window>
