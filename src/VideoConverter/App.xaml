<Application
    x:Class="VideoConverter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:VideoConverter.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 全局样式表：三主题语义画刷 + 统一控件风格（Light/Dark/HighContrast） -->
                <ResourceDictionary Source="ms-appx:///Styles/Overrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:NotNullToBooleanConverter x:Key="NotNullToBoolean" />
            <helpers:InverseBoolToBooleanConverter x:Key="InverseBoolToBoolean" />
            <helpers:QueueStateToGlyphConverter x:Key="StateToGlyph" />
            <helpers:QueueStateToBrushConverter x:Key="StateToBrush" />
            <helpers:QueueStateToBadgeBrushConverter x:Key="StateToBadgeBrush" />
            <helpers:ExtensionLabelConverter x:Key="ExtensionLabel" />
            <helpers:TaskFilterToChipStyleConverter x:Key="FilterChipStyle" />
            <helpers:PathToImageSourceConverter x:Key="PathToImageSource" />
            <helpers:StringToVisibilityConverter x:Key="StringToVisibility" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:InverseBoolToVisibilityConverter x:Key="BoolToVisibilityInverse" />
            <!-- DataTemplate 里绑定页面级 ViewModel 的取值入口（见 ViewModelLocator 注释） -->
            <helpers:ViewModelLocator x:Key="ViewModelLocator" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
