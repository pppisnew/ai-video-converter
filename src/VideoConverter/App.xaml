<Application
    x:Class="VideoConverter.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:VideoConverter.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 全局样式表：三主题语义画刷 + 统一控件风格（Light/Dark/HighContrast） -->
                <ResourceDictionary Source="ms-appx:///Styles/Overrides.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:NotNullToBooleanConverter x:Key="NotNullToBoolean" />
            <helpers:InverseBoolToBooleanConverter x:Key="InverseBoolToBoolean" />
            <helpers:QueueStateToGlyphConverter x:Key="StateToGlyph" />
            <helpers:QueueStateToBrushConverter x:Key="StateToBrush" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>