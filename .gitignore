# --- Trellis：本地开发者身份与会话运行态 ---
.trellis/.developer
.trellis/.current-task
.trellis/.runtime/
.trellis/.ralph-state.json
.trellis/.agent-log
.trellis/.session-id
.trellis/.plan-log

# 任务验收截图（本地产物，不入库）
.trellis/tasks/*/shots/

# --- .NET 构建输出 ---
bin/
obj/
*.user
*.suo

# --- 发布输出 ---
publish/
publish-*/

# --- Python / Node（Trellis 工具链可能用到）---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
*.egg-info/

# --- 环境变量与密钥 ---
.env
.env.*
!.env.example

# --- 操作系统 / 编辑器 ---
Thumbs.db
desktop.ini
.DS_Store

# --- 随应用分发的 ffmpeg 二进制（tools/fetch-ffmpeg.ps1 获取，约 280MB）---
tools/ffmpeg/

# --- 测试产物 ---
tests/**/TempMedia/

# --- 开发期本地脚手架：临时脚本、抓来比对的 JSON、随手截图 ---
e2e-*.ps1
e2e-sample.mp4
pub-*.txt
pub2-*.txt
t.ps1
t2.ps1
uiauto.cs
tcjob.cs
wheel.cs
ui-*.png
fbrel.json
